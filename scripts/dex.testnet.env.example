# scripts/dex.testnet.env.example
#
# Copy to scripts/dex.testnet.env (git-ignored) and fill in.
# Consumed by scripts/seed_testnet_liquidity.sh. See docs/dex-integration.md.
#
#   set -a; source scripts/dex.testnet.env; set +a
#   scripts/seed_testnet_liquidity.sh --dry-run
#
# TESTNET ONLY. The script refuses mainnet unless I_UNDERSTAND_MAINNET_DEX=yes,
# and even then only prints a plan.

# --- Network (defaults are Stellar testnet) ---
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Signing identity (also the wPi / mock-usdc admin for minting) ---
# A local `stellar keys` identity name. A fresh name is generated + Friendbot-funded.
STELLAR_ACCOUNT=wpi-testnet-admin

# --- Token contract IDs ---
# wpi-token, from `make deploy-testnet`.
WPI_CONTRACT_ID=
# mock-usdc. Leave blank to have the script deploy + initialize it and print the id.
MOCK_USDC_CONTRACT_ID=

# --- Soroswap testnet deployment (NOT committed: changes on redeploy) ---
# Fetch current values from Soroswap's published testnet address list.
# Required for --amm soroswap (the default).
SOROSWAP_ROUTER_ID=
SOROSWAP_FACTORY_ID=

# --- Seeding parameters (whole stroops; 1 unit = 1e7) ---
# Opening price (USDC per wPi) = SEED_USDC_AMOUNT / SEED_WPI_AMOUNT.
SEED_WPI_AMOUNT=1000000000000      # 100,000 wPi
SEED_USDC_AMOUNT=314000000000      #  31,400 USDC  -> opens at 0.314 USDC/wPi
SEED_SLIPPAGE_BPS=50               # 0.50% tolerance on amount_*_min
SEED_DEADLINE_SECS=300             # tx must confirm within 5 minutes

# --- Minting toggles (testnet convenience) ---
# When true, the script mints the amounts above to STELLAR_ACCOUNT before seeding.
# Requires STELLAR_ACCOUNT to be the respective token's admin.
SEED_MINT_WPI=false                # wPi is normally minted by the bridge relayer
SEED_MINT_USDC=true                # mock USDC has no other source on testnet

# --- Mainnet guard (leave unset) ---
# I_UNDERSTAND_MAINNET_DEX=
